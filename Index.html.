        </div>
      </div>

      <button onclick="evaluateMealDeal()" class="w-full py-3 bg-yellow-500 hover:bg-yellow-400 text-slate-950 font-bold text-sm rounded-xl transition-all shadow-lg shadow-yellow-500/10">
        Judge My Meal Deal
      </button>

      <div id="meal-deal-result" class="hidden mt-4 p-4 bg-slate-950 border border-yellow-500/30 rounded-xl text-center font-semibold text-sm text-yellow-300"></div>
    </div>

    <!-- Footer -->
    <footer class="text-center text-xs text-slate-500 border-t border-slate-900 pt-6">
      <p>© 2026 Brit IQ Travel • Standalone Web App Edition</p>
    </footer>
  </div>

