        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-2">Select Side</label>
          <select id="meal-side" class="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-xs text-slate-200">
            <option value="">-- Side --</option>
